# Copy this file to .env and fill in your own values. Never commit .env.

# Azure Speech (speech to text + text to speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Voice used for the spoken answer. Full list: https://learn.microsoft.com/azure/ai-services/speech-service/language-support?tabs=tts
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_LANGUAGE=en-US

# Azure OpenAI (writes the answers)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=
# The deployment name you chose in Azure AI Foundry, e.g. gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
